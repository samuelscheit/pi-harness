{
  "name": "pi-harness",
  "private": true,
  "type": "module",
  "description": "Self-improving Pi harness: own base prompt, gateway models, in-harness metrics.",
  "scripts": {
    "install-harness": "node scripts/install.mjs",
    "patch-t3": "node scripts/patch-t3.ts",
    "metrics": "node extensions/metrics/cli.ts",
    "check": "node_modules/.bin/tsc --noEmit -p .",
    "test": "node --test 'test/**/*.test.ts'"
  },
  "pi": {
    "extensions": [
      "extensions/*/index.ts"
    ]
  }
}
